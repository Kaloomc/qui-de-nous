{
  "name": "gorgee",
  "version": "0.2.0",
  "description": "Gorgée : plateforme de jeux de soirée en temps réel (Qui de nous ?, Tu préfères ?…) sur la TV, avec les téléphones comme manettes.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "share": "node scripts/share.js",
    "voices": "node scripts/voices.js",
    "narration": "node scripts/narration.js",
    "loupsoak": "node --expose-gc scripts/loup-soak.js",
    "savantsoak": "node --expose-gc scripts/savant-soak.js",
    "check-facts": "node scripts/check-facts.js",
    "check-culture": "node scripts/check-culture-duel.js",
    "check-duel-content": "node scripts/check-duel-content.js",
    "build-duel-content": "node scripts/build-duel-content.mjs",
    "build-geo-duel": "node scripts/build-geo-duel.mjs",
    "check-nbm": "node scripts/check-nbm.js",
    "check-genre": "node scripts/check-genre-stereotypes.js",
    "sample": "node scripts/content-sample.js",
    "audit:savant": "node scripts/savant-audit.mjs",
    "captures": "node scripts/capture-demo.js",
    "fairness": "node scripts/fairness-report.js",
    "nbmsoak": "node scripts/nbm-soak.js",
    "audit:display": "node scripts/display-audit.mjs",
    "narration:durations": "node scripts/narration-durations.js",
    "loupsim": "node scripts/loup-sim.js",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "playwright": "^1.64.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1",
    "vite": "^5.4.10"
  }
}
