{
  "name": "gorgee",
  "version": "0.2.0",
  "description": "Gorgée : plateforme de jeux de soirée en temps réel (Qui de nous ?, Tu préfères ?…) sur la TV, avec les téléphones comme manettes.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "share": "node scripts/share.js",
    "voices": "node scripts/voices.js",
    "narration": "node scripts/narration.js",
    "loupsim": "node scripts/loup-sim.js",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1",
    "vite": "^5.4.10"
  }
}
